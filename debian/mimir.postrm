#
# mimir postrm: remove keeps the settings, users, key and state; purge
# deletes them, as Debian expects of a purge.

set -e

case "$1" in
    purge)
        rm -rf /etc/mimir /var/lib/mimir
        ;;
esac

#DEBHELPER#

exit 0
